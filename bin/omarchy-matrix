#!/bin/bash

# The switchboard. Each piece turns on and off on its own.
#
#   <cli> on | off
#   <cli> wallpaper|screensaver|lock|boot|widget on|off|toggle
#   <cli> status [--is <piece>] [--json]
#   <cli> doctor
#
# Which pack this is comes from provider.json, below: everything in here is
# machinery, and the provider contributes the shader, its assets and its names.
#
# Settings live in ~/.config/omarchy/<slug>.json, a file of our own. They are
# deliberately NOT in shell.json: `omarchy refresh shell` rewrites that file
# wholesale and would take them with it.

set -euo pipefail

SELF=$(basename "$0")

fail() {
  echo "$SELF: $*" >&2
  exit 1
}

# --- the provider -----------------------------------------------------------
# The pack is machinery plus one provider, and provider.json is the only file
# that names the provider. bin/provider.py resolves it the same way for the two
# derivers: keep the two in step.
#
#   $OMARCHY_MATRIX_PROVIDER          an explicit override, and what tests use
#   ~/.local/share/omarchy-matrix/    where install.sh puts it -- readable even
#                                     while another theme is current, which is
#                                     exactly when `suspend` and `lock off` run
#   next to this script               a working copy, with nothing installed
for candidate in \
  "${OMARCHY_MATRIX_PROVIDER:-}" \
  "$HOME/.local/share/omarchy-matrix/provider.json" \
  "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/provider.json"; do
  [[ -n $candidate && -f $candidate ]] || continue
  PROVIDER="$candidate"
  break
done
[[ -n ${PROVIDER:-} ]] || fail "cannot find provider.json. Re-run the pack's install.sh."

# One jq for all of it: this runs on every menu tick and every toggle.
eval "$(jq -r '@sh "THEME_SLUG=\(.slug) CLI=\(.cli) DISPLAY_NAME=\(.displayName) PLUGIN_ID=\(.plugin.id) WIDGET_ID=\(.widget.id) WIDGET_SECTION=\(.widget.section) PLYMOUTH_THEME=\(.plymouth.theme) IPC=\(.ipc) RAIN_QML=\(.rainFiles[0]) PLUGIN_SRC=\(.plugin.dir) WIDGET_SRC=\(.widget.dir)"' "$PROVIDER")" ||
  fail "$PROVIDER is not valid JSON"

CONFIG="$HOME/.config/omarchy/$THEME_SLUG.json"
PLUGINS_DIR="$HOME/.config/omarchy/plugins"
PIECES=(wallpaper screensaver lock boot widget)

# --- state ------------------------------------------------------------------

# The desktop pieces are only IN EFFECT while the pack's theme is the current
# one:
# picking another theme makes the theme-set hook call `suspend`, which stands
# them down without touching the settings. Without this, `status` used to tick
# four pieces that were in fact off, and the pack looked broken.
#
# `boot` is the exception: the Plymouth splash belongs to the system, not to
# the theme, and stays put whichever theme you pick.
current_theme() {
  cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null
}

pack_in_effect() {
  [[ $(current_theme) == "$THEME_SLUG" ]]
}

# `boot` does not follow the theme, so its tick asks the system instead: is our
# Plymouth theme the one actually in use? That way the ✓ never lies, even though
# it stays on when you switch to another theme.
#
# Not `omarchy plymouth current`: that one identifies the theme by comparing
# logo.png inside Omarchy's OWN theme folder, and ours is a separate theme it
# cannot see. `plymouth-set-default-theme` with no arguments prints the real
# answer and needs no sudo.
boot_applied() {
  local current
  current=$(plymouth-set-default-theme 2>/dev/null) ||
    current=$(sed -n 's/^Theme=//p' /etc/plymouth/plymouthd.conf 2>/dev/null)
  [[ $current == "$PLYMOUTH_THEME" ]]
}

# Switched on in the settings AND in effect right now. This is what the widget
# and `status` ask, so it is what decides the ✓.
#
# The tick is supposed to mean "this is happening now", and for `wallpaper` it
# used to mean "configured". Observed after a round trip to another theme and
# back: `✓ wallpaper` printed with ZERO rain surfaces on screen, because
# `omarchy theme set` rotates to the theme's next background and the rotation
# had landed on a still. Being on the live background is part of the piece being
# on, so it is part of the question.
#
# `boot` asks the system instead of the theme: the Plymouth splash belongs to
# the machine and stays put whichever theme you pick.
is_active() {
  [[ $(read_setting "$1") == "true" ]] || return 1
  case "$1" in
  boot) boot_applied ;;
  wallpaper) pack_in_effect && on_live_background ;;
  widget) pack_in_effect && plugin_enabled "$WIDGET_ID" ;;
  *) pack_in_effect ;;
  esac
}

active_of() {
  is_active "$1" && echo true || echo false
}

read_setting() {
  local piece="$1"
  [[ -f $CONFIG ]] || { echo "true"; return; }
  # `// true` is wrong here: jq treats false as absent, so `boot: false` would
  # come back as true. Ask for the key, not for its value.
  jq -r --arg k "$piece" 'if has($k) then .[$k] else true end | tostring' "$CONFIG" 2>/dev/null || echo "true"
}

write_setting() {
  local piece="$1" value="$2" tmp
  mkdir -p "$(dirname "$CONFIG")"
  [[ -f $CONFIG ]] || echo '{}' >"$CONFIG"
  tmp=$(mktemp "$CONFIG.XXXXXX")
  jq --arg k "$piece" --argjson v "$value" '.[$k] = $v' "$CONFIG" >"$tmp" 2>/dev/null ||
    { rm -f "$tmp"; fail "could not write $CONFIG"; }
  mv "$tmp" "$CONFIG"
}

# `omarchy plugin clone` decides the lock clone's id: <username>.lock. Discover
# it rather than assume it, because on another machine the username differs.
lock_clone_id() {
  local dir
  for dir in "$PLUGINS_DIR"/*.lock; do
    [[ -d $dir ]] || continue
    jq -e '.omarchy.clonedFrom == "omarchy.lock"' "$dir/manifest.json" >/dev/null 2>&1 || continue
    jq -r '.id' "$dir/manifest.json"
    return 0
  done
  return 1
}

# `omarchy plugin remove` does not delete a folder, it renames it to
# .<id>.bak.<timestamp>. That is the right call for a plugin somebody wrote by
# hand, and the wrong one for ours: the lock clone is DERIVED and rebuilds from
# Omarchy's own source in a second, so a backup of it is litter. Nine of them had
# piled up here during development before anyone noticed.
#
# Ours is a folder carrying the provider's rain QML -- the deriver copies it into
# every folder the pack owns -- or the rain plugin itself. A lock clone somebody
# made for their own reasons has the same name shape and must survive untouched.
ours() {
  [[ -f "$1/$RAIN_QML" ]] && return 0
  [[ -f "$1/manifest.json" ]] &&
    [[ $(jq -r '.id // empty' "$1/manifest.json" 2>/dev/null) == "$PLUGIN_ID" ]]
}

prune_backups() {
  local dir
  for dir in "$PLUGINS_DIR"/.*.bak.*; do
    [[ -d $dir ]] || continue
    if ours "$dir"; then rm -rf "$dir"; fi
  done
  return 0
}

# The pack's only footprint outside $HOME. `omarchy plymouth reset` puts
# Omarchy's theme back but leaves ours sitting in /usr/share/plymouth/themes, so
# off has to take it back too -- someone who never runs uninstall.sh would carry
# it forever otherwise (Rule 5: off must mean gone).
#
# Always AFTER the reset, never before: pulling the directory out from under a
# theme that is still the default is how a machine boots to a black screen.
remove_plymouth_theme() {
  local dir="/usr/share/plymouth/themes/$PLYMOUTH_THEME"
  [[ -d $dir ]] || return 0
  sudo rm -rf "$dir"
}

plugin_enabled() {
  omarchy-plugin-list --json 2>/dev/null |
    jq -e --arg id "$1" 'any(.[]; .id == $id and .enabled)' >/dev/null 2>&1
}

plugin_known() {
  omarchy-plugin-list --json 2>/dev/null |
    jq -e --arg id "$1" 'any(.[]; .id == $id)' >/dev/null 2>&1
}

nudge_shell() {
  omarchy-shell "$IPC" refresh >/dev/null 2>&1 || true
}

# --- the theme directory ----------------------------------------------------
#
# `omarchy theme update` is a bare `git pull` per theme and fires NO hooks --
# not one, and `omarchy update` never calls it. So after a pull the theme moves
# on while the pack's copies of the plugin, the CLI, the derivers and the hooks
# sit at whatever version installed them. Nothing else would ever notice.
#
# So the CLI notices, on the one run that is meant to assert everything again:
# `doctor`, which the theme-set hook calls on every `omarchy theme set <slug>`.

theme_dir() {
  omarchy-theme-dir "$THEME_SLUG" 2>/dev/null
}

# Every file install.sh copies out of the theme directory, paired with where it
# lands. Kept here rather than derived from install.sh because a comparison that
# silently checks nothing is worse than no comparison at all.
installed_pairs() {
  local theme="$1" f
  for f in $(jq -r '.plugin.files[]' "$PROVIDER"); do
    echo "$theme/$PLUGIN_SRC/$f|$PLUGINS_DIR/$PLUGIN_ID/$f"
  done
  for f in $(jq -r '.widget.files[]' "$PROVIDER"); do
    echo "$theme/$WIDGET_SRC/$f|$PLUGINS_DIR/$WIDGET_ID/$f"
  done
  echo "$theme/bin/$CLI|$HOME/.local/bin/$CLI"
  echo "$theme/bin/derive-lock.py|$HOME/.local/bin/derive-lock.py"
  echo "$theme/bin/derive-plymouth.py|$HOME/.local/bin/derive-plymouth.py"
  echo "$theme/bin/provider.py|$HOME/.local/bin/provider.py"
  echo "$theme/uninstall.sh|$HOME/.local/bin/$CLI-uninstall"
  echo "$theme/hooks/theme-set|$HOME/.config/omarchy/hooks/theme-set.d/$THEME_SLUG"
  echo "$theme/hooks/post-update|$HOME/.config/omarchy/hooks/post-update.d/$THEME_SLUG"
  echo "$theme/provider.json|$HOME/.local/share/omarchy-matrix/provider.json"
}

# NEWER, not merely different. "Different" is the wrong question and it bit on
# the first run: a working copy installed over an older theme directory looks
# exactly as different as a pulled theme looks over an older install, and
# syncing then copies the OLD files over the new ones. A `git pull` gives every
# file it changes a fresh mtime, which is precisely the event this is for.
#
# A source file that is missing is not staleness either, it is a theme directory
# that does not carry that file -- an older or a newer layout.
files_outdated() {
  local theme="$1" source target
  while IFS='|' read -r source target; do
    [[ -f $source ]] || continue
    [[ -f $target && ! $source -nt $target ]] || return 0
  done < <(installed_pairs "$theme")
  return 1
}

sync_files() {
  local theme
  theme=$(theme_dir) || return 0
  [[ -n $theme && -x $theme/install.sh ]] || return 0
  # An install.sh old enough not to know --sync would run the whole thing --
  # questions, boot splash and all -- from inside a doctor that is only meant to
  # refresh files. Ask before calling.
  grep -q -- '--sync' "$theme/install.sh" 2>/dev/null || return 0
  files_outdated "$theme" || return 0
  echo "  the theme directory has moved on; refreshing the pack's copies"
  "$theme/install.sh" --sync || echo "  could not refresh them; run $theme/install.sh" >&2
}

# --- pieces -----------------------------------------------------------------

# The plugin is needed if either of its two layers is on.
sync_plugin() {
  local wanted="false"
  [[ $(read_setting wallpaper) == "true" || $(read_setting screensaver) == "true" ]] && wanted="true"

  if ! plugin_known "$PLUGIN_ID"; then
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    sleep 0.3
  fi
  plugin_known "$PLUGIN_ID" || {
    echo "$SELF: the $PLUGIN_ID plugin is not installed" >&2
    # NOT `omarchy plugin add <repo-url>`: that would install the whole repo as
    # the plugin, bypassing the CLI, the hooks and the menu. install.sh copies in
    # the five files the plugin actually needs. It is the only supported path.
    echo "  install it with: $(omarchy-theme-dir "$THEME_SLUG" 2>/dev/null || echo "~/.config/omarchy/themes/$THEME_SLUG")/install.sh" >&2
    return 1
  }

  if [[ $wanted == "true" ]]; then
    plugin_enabled "$PLUGIN_ID" || omarchy-plugin-enable "$PLUGIN_ID" >/dev/null
  else
    ! plugin_enabled "$PLUGIN_ID" || omarchy-plugin-disable "$PLUGIN_ID" >/dev/null
  fi
}

# The desktop rain is picked like any other background in the carousel, so
# switching the piece on without selecting that background would show nothing:
# a ✓ in the menu and an unchanged screen. Switching it on selects it; switching
# it off moves away from it, because sitting on the still frame looks exactly
# like rain that has frozen.
#
# Careful with `omarchy theme set`: it rotates to the NEXT background of the
# theme, so re-applying the theme takes you off the live background. That
# theme-set hook does not force it -- that would be fighting Omarchy -- and this
# switch does it instead.
# The live background is whichever file carries "-live-" in its name, never a
# fixed number: sort order decides the theme's default and gets reshuffled.
#
# It used to be a screenshot of the shader, which was a poor thing to hand
# someone who installed the theme alone -- a frozen frame of the one thing that
# is supposed to move. Now a real still from the film does all three jobs:
# thumbnail in the picker, the marker that turns the rain on, and the frame you
# are left looking at if the plugin is off.
BACKGROUNDS="$HOME/.local/state/omarchy/current/theme/backgrounds"

live_background() {
  local f
  for f in "$BACKGROUNDS"/*-live-*; do
    [[ -f $f ]] || continue
    echo "$f"
    return 0
  done
  return 1
}

on_live_background() {
  [[ $(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null) == *-live-* ]]
}

select_live_background() {
  local live
  live=$(live_background) || return 0
  on_live_background || omarchy-theme-bg-set "$live" >/dev/null
}

apply_wallpaper() {
  if [[ $(read_setting wallpaper) == "true" ]]; then
    select_live_background
  elif on_live_background; then
    omarchy-theme-bg-next >/dev/null
  fi
  sync_plugin && nudge_shell
}

# With the flag set, omarchy-launch-screensaver bows out instead of opening the
# terminal with ttfx: the screensaver is drawn by our plugin, which is the same
# shader as the wallpaper and the lock.
sync_screensaver() {
  if [[ $(read_setting screensaver) == "true" ]]; then
    omarchy-toggle screensaver-off on
  else
    omarchy-toggle screensaver-off off
  fi
}

apply_screensaver() {
  sync_screensaver
  sync_plugin && nudge_shell
}

# Swapping the lock plugin has a window -- a second or two -- in which neither
# handler answers. The journal shows why: while both are momentarily loaded,
# Quickshell rejects one with "another handler is registered for target lock",
# and until the survivor finishes registering, `omarchy-shell lock status` says
# "Target not found.".
#
# Nothing has ever locked inside that window here. But Rule 4 is "never leave
# the machine unable to lock", and "it self-heals in about a second" is not the
# same statement. So wait for the target to come back, and if it does not, say
# what to do about it rather than returning success.
# Which plugins currently provide a lock. Compared before and after a swap:
# when this set changes, two lock plugins were briefly loaded at once and the
# shell has to be restarted. See restart_shell_for_lock.
enabled_locks() {
  omarchy-plugin-list --json 2>/dev/null |
    jq -r '[.[] | select(.enabled and (.id | endswith(".lock"))) | .id] | sort | join(",")'
}

# Swapping which plugin owns the lock leaves BOTH loaded in the running shell.
# Quickshell then hands the `lock` IPC target to one of them and refuses the
# other:
#
#   QML IpcHandler ... Handler was registered but will not be used because
#   another handler is registered for target lock
#
# Which one wins is not ours to choose, and here it alternated from run to run.
# When Omarchy's won, the machine locked to Omarchy's blurred wallpaper -- while
# `plugin list` reported cyberdyne.lock enabled, `lock status` answered, and the
# patched QML sat on disk exactly right. Every check the pack had passed. Only a
# screenshot of `omarchy-shell lock preview` showed the truth.
#
# `rescanPlugins` does not unload the loser; a restart does. This is the trap
# already written down in CLAUDE.md, reaching the one piece where being wrong is
# invisible until you lock the screen.
restart_shell_for_lock() {
  echo "  restarting the shell so only one lock plugin is loaded"
  omarchy-restart-shell >/dev/null 2>&1 || return 1
}

# Waits for a STEADY answer, not for the first one. Measured here: `lock off`
# returns after ~0.8s, while the handler on its way out is still registered and
# still replying; the real gap does not open until ~1.3s and lasts ~0.6s. A
# guard that stops at the first success is answered by the plugin that is
# leaving, and reports everything fine a second before nothing answers at all.
#
# So: 1.8s of uninterrupted replies, and any silence resets the count.
wait_for_lock() {
  local steady=0 waited=0
  while ((waited < 100)); do # 15s ceiling
    if omarchy-shell lock status 2>/dev/null | jq -e '.passwordPam' >/dev/null 2>&1; then
      steady=$((steady + 1))
      ((steady < 12)) || return 0
    else
      steady=0
    fi
    sleep 0.15
    waited=$((waited + 1))
  done
  echo "$SELF: the lock is not answering steadily after the swap." >&2
  echo "  Run 'omarchy restart shell' before locking the screen." >&2
  return 1
}

# Handing Omarchy's lock back ALWAYS goes through `plugin remove`, which is what
# re-enables it (cloneSourceRestores). Merely disabling the clone would leave
# the session with no lock enabled at all, because cloning put Omarchy's own
# into disabledPlugins: the machine could not lock.
remove_lock_clone() {
  local id
  id=$(lock_clone_id) || return 0
  omarchy-plugin-remove "$id" --yes >/dev/null 2>&1 ||
    omarchy-plugin-remove "$id" >/dev/null 2>&1 || true
  prune_backups
}

apply_lock() {
  local before after
  before=$(enabled_locks)

  if [[ $(read_setting lock) == "true" ]]; then
    "$(dirname "${BASH_SOURCE[0]}")/derive-lock.py" || return 1
  else
    if lock_clone_id >/dev/null; then
      remove_lock_clone
      echo "Handed the lock back to Omarchy"
    else
      return 0 # nothing was swapped, nothing to wait for
    fi
  fi

  # Only when the set actually changed. Re-deriving over a clone that was
  # already the enabled one -- what the theme-set hook does on every `omarchy
  # theme set <slug>` -- loads no second plugin and needs no restart.
  after=$(enabled_locks)
  [[ $before == "$after" ]] || restart_shell_for_lock
  wait_for_lock
}

# The bar icon and its panel: the pack's own switchboard, one click away.
#
# For a plugin of kind `bar-widget`, "enabled" means "present in bar.layout" --
# PluginRegistry.setEnabled inserts the entry there and removes it again
# (PluginRegistry.qml:498-520). That is why the widget is a plugin of its own
# and not another kind on the rain: turning both rain layers off disables that
# plugin, and folding the two together would take the icon off the bar with them.
apply_widget() {
  if [[ $(read_setting widget) == "true" ]]; then
    if ! plugin_known "$WIDGET_ID"; then
      omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
      sleep 0.3
    fi
    plugin_known "$WIDGET_ID" || {
      echo "$SELF: the $WIDGET_ID plugin is not installed" >&2
      return 1
    }
    plugin_enabled "$WIDGET_ID" ||
      omarchy-plugin-enable "$WIDGET_ID" --section "$WIDGET_SECTION" >/dev/null
  else
    ! plugin_enabled "$WIDGET_ID" || omarchy-plugin-disable "$WIDGET_ID" >/dev/null
  fi
}

apply_boot() {
  # The screen before login. Needs sudo and rebuilds the initramfs, so it never
  # happens on its own: only when you ask for it.
  #
  # `omarchy plymouth set-by-theme` will not do: it only takes colours and a
  # still PNG, and here the line is typed out. derive-plymouth.py starts from
  # this machine's omarchy.script and adds the animation, leaving Omarchy's own
  # theme untouched in its folder. Going back is `omarchy plymouth reset`.
  if [[ $(read_setting boot) == "true" ]]; then
    "$(dirname "${BASH_SOURCE[0]}")/derive-plymouth.py" || return 1
  else
    # Only reset when OUR theme is the one installed. Resetting unconditionally
    # rebuilt the initramfs for nothing, and worse, it dragged somebody who had
    # picked `spinner` back to Omarchy's -- overriding a choice the pack never
    # made. The directory goes either way.
    if boot_applied; then
      omarchy-plymouth-reset || return 1
    fi
    remove_plymouth_theme
  fi
}

apply_piece() {
  case "$1" in
  wallpaper) apply_wallpaper ;;
  screensaver) apply_screensaver ;;
  lock) apply_lock ;;
  boot) apply_boot ;;
  widget) apply_widget ;;
  esac
}

# --- commands ---------------------------------------------------------------

cmd_status() {
  local format="text" query="" piece
  while (($# > 0)); do
    case "$1" in
    --json) format="json"; shift ;;
    --is) query="${2:-}"; shift 2 ;;
    *) fail "unknown option: $1" ;;
    esac
  done

  if [[ -n $query ]]; then
    [[ " ${PIECES[*]} " == *" $query "* ]] || fail "unknown piece: $query"
    # What answers the menu's ✓: on AND in effect, not merely on.
    is_active "$query"
    return
  fi

  if [[ $format == "json" ]]; then
    # `settings` is what you asked for, `active` is what is happening. They are
    # not the same question -- see is_active -- and the widget draws its ticks
    # from `active` so that one definition serves both it and the text below.
    jq -n \
      --argjson w "$(read_setting wallpaper)" --argjson s "$(read_setting screensaver)" \
      --argjson l "$(read_setting lock)" --argjson b "$(read_setting boot)" \
      --argjson aw "$(active_of wallpaper)" --argjson as "$(active_of screensaver)" \
      --argjson al "$(active_of lock)" --argjson ab "$(active_of boot)" \
      --argjson effect "$(pack_in_effect && echo true || echo false)" \
      --arg theme "$(current_theme)" --arg name "$DISPLAY_NAME" --arg slug "$THEME_SLUG" \
      '{name: $name, slug: $slug, theme: $theme, active: $effect,
        settings: {wallpaper: $w, screensaver: $s, lock: $l, boot: $b},
        pieces: {wallpaper: $aw, screensaver: $as, lock: $al, boot: $ab}}'
    return
  fi

  if ! pack_in_effect; then
    printf '  the pack is stood down: the current theme is \033[1m%s\033[0m, not %s\n' \
      "$(current_theme)" "$THEME_SLUG"
    printf '  bring it back with: omarchy theme set %s\n\n' "$THEME_SLUG"
  fi

  for piece in "${PIECES[@]}"; do
    if is_active "$piece"; then
      printf '  \033[32m✓\033[0m %-12s\n' "$piece"
    elif [[ $(read_setting "$piece") != "true" ]]; then
      printf '    %-12s\n' "$piece"
    elif [[ $piece == "boot" ]]; then
      printf '    %-12s \033[2mon, but not applied — run: %s boot on\033[0m\n' "$piece" "$SELF"
    elif ! pack_in_effect; then
      printf '    %-12s \033[2mon, but stood down with the theme\033[0m\n' "$piece"
    elif [[ $piece == "wallpaper" ]]; then
      # The one case that is neither: the theme is ours and the piece is on, but
      # the desktop is showing another background from the carousel.
      printf '    %-12s \033[2mon, but the desktop is on another background — run: %s wallpaper on\033[0m\n' \
        "$piece" "$SELF"
    else
      printf '    %-12s \033[2mon, but not in effect — run: %s doctor\033[0m\n' "$piece" "$SELF"
    fi
  done

  if pack_in_effect && ! plugin_enabled "$PLUGIN_ID"; then
    printf '\n  the %s plugin is not active — fix it with: %s doctor\n' "$PLUGIN_ID" "$SELF"
  fi
}

cmd_doctor() {
  # Asserts everything again. This is what to run after an
  # `omarchy refresh shell`, which rewrites shell.json and leaves the plugin off.
  local failures=0
  echo "Checking the pack..."
  sync_files
  sync_screensaver
  sync_plugin || failures=1
  # The background too, when the piece is on. This is the other half of the ✓
  # that lied: `omarchy theme set` rotates to the next background, so coming
  # back to this theme lands on a still and the rain the user asked for is gone.
  # It only ever fights the rotation for somebody who explicitly asked for the
  # rain, which the settings already record -- and the carousel (`bg next`, the
  # picker) never calls a hook, so a deliberate pick inside the theme still
  # stands until the next `theme set`.
  [[ $(read_setting wallpaper) != "true" ]] || select_live_background
  apply_widget || failures=1
  [[ $(read_setting lock) != "true" ]] || apply_lock || failures=1
  nudge_shell
  # `boot` is left out on purpose: it needs sudo and this runs from hooks.
  cmd_status
  return $failures
}

# When the current theme stops being ours, the pack stands down without touching
# the settings: coming back restores exactly what you had.
#
# The lock stands down by deleting the clone, not by disabling it: see
# remove_lock_clone. `boot` is left alone, since the Plymouth splash belongs to
# the system rather than to the theme.
cmd_suspend() {
  ! plugin_enabled "$PLUGIN_ID" || omarchy-plugin-disable "$PLUGIN_ID" >/dev/null
  # The bar icon goes with the rest: a Matrix switch on the bar under somebody
  # else's theme is the pack refusing to stand down (Rule 5).
  ! plugin_enabled "$WIDGET_ID" || omarchy-plugin-disable "$WIDGET_ID" >/dev/null
  omarchy-toggle screensaver-off off
  if lock_clone_id >/dev/null; then
    remove_lock_clone
    # Standing down runs from the theme-set hook, where nobody is watching the
    # output -- which is exactly when being left without a lock, or left with
    # the wrong one still painting, would go unnoticed.
    restart_shell_for_lock
    wait_for_lock
  fi
}

cmd_all() {
  local value="$1" piece
  for piece in wallpaper screensaver lock; do
    write_setting "$piece" "$value"
  done
  apply_screensaver
  apply_lock
  cmd_status
}

usage() {
  cat <<USAGE
Usage: $SELF <command>

  on | off                            Turn the whole pack on or off
  wallpaper|screensaver|lock|boot|widget on|off|toggle
                                      One piece at a time
  status [--is <piece>] [--json]      What is on
  doctor                              Assert everything again
  suspend                             Stand the pack down, keeping your settings

Pieces:
  wallpaper    Rain on the desktop (selects the live background)
  screensaver  Rain when you go idle, instead of Omarchy's terminal one
  lock         Rain behind the password field when you lock
  boot         The screen before login (Plymouth). Needs sudo.
  widget       The switchboard on the bar: these switches, one click away
USAGE
}

command="${1:-status}"
shift || true

case "$command" in
on) cmd_all true ;;
off) cmd_all false ;;
status) cmd_status "$@" ;;
doctor) cmd_doctor ;;
suspend) cmd_suspend ;;
wallpaper | screensaver | lock | boot | widget)
  action="${1:-toggle}"
  case "$action" in
  show)
    # This is what Omarchy's menu row calls. Its stock action is
    # `omarchy-launch-screensaver force`, and that `force` skips the
    # screensaver-off flag on purpose. Without this, asking for it from the menu
    # brought up Omarchy's own with random effects even with the piece ticked.
    [[ $command == "screensaver" ]] || fail "'show' only applies to screensaver"
    if [[ $(read_setting screensaver) == "true" ]]; then
      omarchy-shell "$IPC" screensaver start >/dev/null
    else
      omarchy-launch-screensaver force
    fi
    exit 0
    ;;
  on) write_setting "$command" true ;;
  off) write_setting "$command" false ;;
  toggle) [[ $(read_setting "$command") == "true" ]] && write_setting "$command" false || write_setting "$command" true ;;
  *) fail "unknown action: $action (use on, off or toggle)" ;;
  esac
  apply_piece "$command"
  ;;
provider)
  # What the hooks ask when they need to know the provider's names. They are
  # installed once and then live in ~/.config/omarchy/hooks, where they have no
  # idea where provider.json ended up -- this script does.
  [[ $# -gt 0 ]] || fail "provider needs a key, e.g. slug or plugin.id"
  jq -r ".$1" "$PROVIDER"
  ;;
-h | --help | help) usage ;;
*) usage; exit 1 ;;
esac
