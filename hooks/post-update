#!/bin/bash
# Pack hook. Installed at ~/.config/omarchy/hooks/post-update.d/<slug>, where
# Omarchy calls it during `omarchy update`, once the new packages are in.
#
# The pack replaces two things of Omarchy's -- the lock plugin and the Plymouth
# theme -- and neither ships as a frozen copy: both are derived from the source
# on this machine. A frozen copy would fall behind, and the lock in particular
# carries the PAM and fingerprint flows inside it.
#
# If Omarchy's source has changed enough that a patch no longer fits, the
# derivers abort and say so instead of leaving things half done.

command -v omarchy-matrix >/dev/null 2>&1 || exit 0

name=$(omarchy-matrix provider displayName 2>/dev/null) || exit 0

# The boot splash needs sudo, and there is a terminal here: `omarchy update` is
# interactive.
if omarchy-matrix status --is boot 2>/dev/null; then
  omarchy-matrix boot on || echo "$name: could not re-derive the boot splash" >&2
fi

omarchy-matrix status --is lock 2>/dev/null || exit 0

if ! omarchy-matrix lock on; then
  omarchy-notification-send -g 󱄄 "$name" \
    "Omarchy's lock has changed and the rain patch no longer fits. Native lock for now." \
    2>/dev/null || true
fi
