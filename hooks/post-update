#!/bin/bash
# Pack hook. Installed at ~/.config/omarchy/hooks/post-update.d/<slug>, where
# Omarchy calls it during `omarchy update`, once the new packages are in.
#
# The pack replaces two things of Omarchy's -- the lock plugin and the Plymouth
# theme -- and neither ships as a frozen copy: both are derived from the source
# on this machine. A frozen copy would fall behind, and the lock in particular
# carries the PAM and fingerprint flows inside it.
#
# If Omarchy's source has changed enough that a patch no longer fits, the
# derivers abort and say so instead of leaving things half done.

provider="$HOME/.local/share/omarchy-matrix/provider.json"
[[ -f $provider ]] || exit 0
cli=$(jq -r '.cli // empty' "$provider" 2>/dev/null)
[[ -n $cli ]] || exit 0
command -v "$cli" >/dev/null 2>&1 || exit 0

name=$("$cli" provider displayName 2>/dev/null) || exit 0

# First, in case the theme directory was pulled since: `omarchy theme update`
# fires no hooks of its own, so doctor's staleness check is the only thing that
# ever refreshes the pack's copies. It also re-asserts the plugin AND re-derives
# the lock when that piece is on (apply_lock) -- so there is no second `lock on`
# here: against the same updated source the same patch fails the same way, and
# the only thing a retry added was the work.
"$cli" doctor >/dev/null 2>&1 || true

# The boot splash needs sudo, and there is a terminal here: `omarchy update` is
# interactive.
if "$cli" status --is boot 2>/dev/null; then
  "$cli" boot on || echo "$name: could not re-derive the boot splash" >&2
fi

# What remains of the lock is doctor's failure mode: the patch no longer fits
# the updated LockView.qml, the derive handed the lock back, and nobody is
# watching a hook's stdout. Say so -- but only when the piece is wanted and the
# pack is in effect: stood down by design is not a failure, and neither is a
# piece the user switched off.
status=$("$cli" status --json 2>/dev/null) || exit 0
[[ $(jq -r '.active and .settings.lock' <<<"$status") == "true" ]] || exit 0
[[ $(jq -r '.pieces.lock' <<<"$status") == "true" ]] && exit 0

omarchy-notification-send -g 󱄄 "$name" \
  "Omarchy's lock has changed and the rain patch no longer fits. Native lock for now." \
  2>/dev/null || true
